# Runtime
NODE_ENV=development
PORT=4000

# Authentication
SECRET_KEY='a-string-secret-at-least-256-bits-long'
ONE_TIME_TOKEN_SECRET='replace-with-a-long-random-secret'
ONE_TIME_TOKEN_TTL_MS=60000
AUTH_TOKEN_MAX_LIFETIME_MS=600000

# Contact
TELEGRAM_BOT_TOKEN='replace-with-your-bot-token'
TELEGRAM_CHAT_ID='replace-with-your-chat-id'

# Storage
DATABASE_PATH='../../infra/database'
CONTENT_PATH='../../infra/content'
UPLOADS_PATH='../../infra/uploads'
AUDIO_COVERS_PATH='../../infra/covers'
FILE_INSPECTOR_CACHE_PATH='../../infra/caches/file-inspector'

# HTTP
JSON_BODY_LIMIT='1mb'
CORS_ORIGIN='http://localhost:3000'
REQUEST_TIMEOUT_MS=30000
HEADERS_TIMEOUT_MS=10000
KEEP_ALIVE_TIMEOUT_MS=5000